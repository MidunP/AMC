# ─── Telegram Bot ───────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your personal Telegram Chat ID (get it from @myidbot or @userinfobot)
TELEGRAM_CHAT_ID=987654321

# ─── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data/tickets.db

# ─── Watcher Behaviour ──────────────────────────────────────────────────────────
# How often to poll BookMyShow (minimum 3 to respect rate limits)
POLL_INTERVAL_MINUTES=5

# ─── Logging ────────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Environment: development (pretty logs) | production (JSON logs)
NODE_ENV=production

# ─── Email Notifications ────────────────────────────────────────────────────────
# Personal email where ticket alerts & status updates will be sent
EMAIL_TO=user@example.com
EMAIL_FROM="Broadway Watcher <watcher@example.com>"

# SMTP Server Settings (e.g., Gmail SMTP or App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_ENABLED=true

